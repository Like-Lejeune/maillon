# Copier ce fichier vers .env et remplir les valeurs. Ne jamais committer .env.

# Environnement
APP_ENV=staging
APP_URL=https://staging.example.com
API_URL=https://api.example.com

# Base de données PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maillon
DB_USER=maillon
DB_PASSWORD=

# File d'attente Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Stockage compatible S3 (modèles et résultats)
S3_ENDPOINT=
S3_BUCKET=maillon
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sécurité
APP_SECRET=
AGENT_TOKEN_SECRET=

# Facturation
COMMISSION_RATE=
