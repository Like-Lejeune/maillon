# Copier ce fichier vers /srv/maillon/<staging|production>/.env et remplir les
# valeurs. Ne jamais committer un fichier .env.
# Générer un secret : openssl rand -hex 32

# Environnement : staging ou production
APP_ENV=staging

# Base de données PostgreSQL (conteneur « postgres » de la pile)
DB_NAME=maillon
DB_USER=maillon
DB_PASSWORD=

# File d'attente Redis (conteneur « redis » de la pile)
REDIS_PASSWORD=

# Sécurité
APP_SECRET=
AGENT_TOKEN_SECRET=

# Facturation : part de la plateforme, entre 0 et 1
COMMISSION_RATE=0.20
